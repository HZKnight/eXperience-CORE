<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns="https://phpdoc.org/config"
>
    <paths>
        <output>docs</output>
        <cache>.phpdoc/cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>src</path>
                
                <ignore>
                    <path>vendor/**</path>
                    <path>tests/**</path>
                </ignore>
            </source>
        </api>
    </version>
</phpdocumentor>