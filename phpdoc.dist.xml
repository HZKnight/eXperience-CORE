<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns="https://phpdoc.org/config"
>
    <paths>
        <output>docs</output>
        <cache>.phpdoc/cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <ignore>
                <path>src/Experience/vendor/**/*</path>
                <path>tests/**/*</path>
            </ignore>
        </api>

        <template name="clean">
            <parameter key="title" value="eXperience Core | Documentation" />
            <parameter key="logo" value="assets/logodoc.png" />
        </template>
        
    </version> 
</phpdocumentor>